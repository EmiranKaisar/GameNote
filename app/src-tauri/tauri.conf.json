{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Note",
  "version": "0.1.0",
  "identifier": "com.gamenote.matchreview",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Game Note",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' stream: http://stream.localhost asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Hangzhou Amuswen Network Technology Co., Ltd.",
    "copyright": "Copyright © 2026 Hangzhou Amuswen Network Technology Co., Ltd.",
    "license": "MIT License",
    "resources": {
      "../company-info.json": "company-info.json",
      "../../LICENSE": "LICENSE",
      "../../PRIVACY.md": "PRIVACY.md",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Sports",
    "shortDescription": "Review match video with frame notes and drawings"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Note release information",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updateSummary"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "updateSummary": { "type": "string", "minLength": 1, "maxLength": 240 }
  }
}
